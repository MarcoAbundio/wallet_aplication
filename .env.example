# Used by docker-compose.yml to configure Postgres, the backend and CORS.
# Copy this file to .env before running `docker compose up`.

POSTGRES_USER=cartera
POSTGRES_PASSWORD=cartera_password
POSTGRES_DB=cartera_db

# Public URL of the frontend, used to configure backend CORS.
CORS_ORIGIN=http://localhost:8080

