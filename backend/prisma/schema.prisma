// Prisma schema for Cartera - Loan management platform
// docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserRole {
  ADMIN // Full access: users, configuration, all operations
  MANAGER // Can manage clients, loans, payments and view reports
  CASHIER // Can register clients, loans and collect payments
}

enum ClientStatus {
  ACTIVE
  INACTIVE
}

enum LoanStatus {
  PENDING // Approved but not yet disbursed
  ACTIVE // Disbursed, has installments pending
  PAID // Fully paid
  OVERDUE // Has at least one overdue installment
  CANCELLED
}

enum PaymentFrequency {
  WEEKLY
  BIWEEKLY
  MONTHLY
}

enum InstallmentStatus {
  PENDING
  PAID
  PARTIAL
  OVERDUE
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CARD
  MOBILE_WALLET
}

// ---------------------------------------------------------------------------
// Models
// ---------------------------------------------------------------------------

model User {
  id           String    @id @default(uuid())
  name         String
  email        String    @unique
  passwordHash String
  role         UserRole  @default(CASHIER)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  refreshTokens  RefreshToken[]
  clientsCreated Client[]       @relation("ClientCreatedBy")
  loansCreated   Loan[]         @relation("LoanCreatedBy")
  paymentsTaken  Payment[]      @relation("PaymentRegisteredBy")

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  tokenHash String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

model Client {
  id           String       @id @default(uuid())
  firstName    String
  lastName     String
  documentId   String       @unique // national ID / cédula / DNI
  email        String?
  phone        String
  address      String?
  occupation   String?
  monthlyIncome Decimal?    @db.Decimal(12, 2)
  status       ClientStatus @default(ACTIVE)
  notes        String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  createdById String?
  createdBy   User?   @relation("ClientCreatedBy", fields: [createdById], references: [id])

  loans Loan[]

  @@index([documentId])
  @@index([firstName, lastName])
  @@map("clients")
}

model Loan {
  id               String           @id @default(uuid())
  code             String           @unique // human friendly loan code e.g. PR-000123
  clientId         String
  client           Client           @relation(fields: [clientId], references: [id])
  principal        Decimal          @db.Decimal(12, 2)
  interestRate     Decimal          @db.Decimal(5, 2) // annual percentage rate
  termInstallments Int // number of installments
  frequency        PaymentFrequency @default(MONTHLY)
  startDate        DateTime
  status           LoanStatus       @default(ACTIVE)
  totalToPay       Decimal          @db.Decimal(12, 2)
  purpose          String?
  notes            String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  createdById String?
  createdBy   User?   @relation("LoanCreatedBy", fields: [createdById], references: [id])

  installments Installment[]
  payments     Payment[]

  @@index([clientId])
  @@index([status])
  @@map("loans")
}

model Installment {
  id            String            @id @default(uuid())
  loanId        String
  loan          Loan              @relation(fields: [loanId], references: [id], onDelete: Cascade)
  number        Int
  dueDate       DateTime
  amountDue     Decimal           @db.Decimal(12, 2)
  principalPart Decimal           @db.Decimal(12, 2)
  interestPart  Decimal           @db.Decimal(12, 2)
  amountPaid    Decimal           @default(0) @db.Decimal(12, 2)
  status        InstallmentStatus @default(PENDING)
  paidAt        DateTime?

  payments Payment[]

  @@unique([loanId, number])
  @@index([loanId])
  @@index([status])
  @@index([dueDate])
  @@map("installments")
}

model Payment {
  id             String        @id @default(uuid())
  loanId         String
  loan           Loan          @relation(fields: [loanId], references: [id])
  installmentId  String?
  installment    Installment?  @relation(fields: [installmentId], references: [id])
  amount         Decimal       @db.Decimal(12, 2)
  method         PaymentMethod @default(CASH)
  paidAt         DateTime      @default(now())
  reference      String?
  notes          String?
  createdAt      DateTime      @default(now())

  registeredById String?
  registeredBy   User?   @relation("PaymentRegisteredBy", fields: [registeredById], references: [id])

  @@index([loanId])
  @@index([paidAt])
  @@map("payments")
}
